# Icarus Verilog and ngspice from Debian stable, for compute/verify_courses.py's `verilog` and `spice`
# runners (Lumenary EE): docker build -t lumenary/eda-toolchains -f compute/toolchains/Dockerfile.eda .
FROM debian:stable-slim
RUN apt-get update && apt-get install -y --no-install-recommends iverilog ngspice && rm -rf /var/lib/apt/lists/*
