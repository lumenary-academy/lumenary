# Free Pascal and GNAT (Ada) from Debian stable, for compute/verify_courses.py's `pascal` and `ada`
# runners: docker build -t lumenary/debian-toolchains -f compute/toolchains/Dockerfile.debian .
FROM debian:stable-slim
RUN apt-get update && apt-get install -y --no-install-recommends fp-compiler gnat && rm -rf /var/lib/apt/lists/*
