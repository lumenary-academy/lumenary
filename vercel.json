{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:locale(en|es|ar|hi|sw|zh-Hans)/divisions/:path(.*)?",
      "destination": "https://lumenary.academy/:locale/divisions/",
      "permanent": true
    },
    {
      "source": "/:locale(en|es|ar|hi|sw|zh-Hans)/lingua/spanish/:path(.*)?",
      "destination": "https://lingua.lumenary.academy/en/spanish/:path",
      "permanent": true
    },
    {
      "source": "/:locale(en|es|ar|hi|sw|zh-Hans)/lingua/ingles/:path(.*)?",
      "destination": "https://lingua.lumenary.academy/es/ingles/:path",
      "permanent": true
    },
    {
      "source": "/:locale(en|es|ar|hi|sw|zh-Hans)/lingua/:path(.*)?",
      "destination": "https://lingua.lumenary.academy/:locale/",
      "permanent": true
    }
  ]
}
